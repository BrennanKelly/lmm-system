# Lake Michigan Marketing — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# GoHighLevel Private Integration
# Get from: GHL Agency Dashboard → Settings → Integrations → Private Integrations
GHL_API_KEY=your_private_integration_token_here

# GHL Location ID for the active client sub-account
# Get from: GHL Sub-account → Settings → Business Info → Location ID
GHL_LOCATION_ID=your_location_id_here

# GHL Agency ID (for creating sub-accounts via API)
GHL_AGENCY_ID=your_agency_id_here

# Twilio (if using Twilio directly instead of GHL's built-in SMS)
# Only needed if you outgrow GHL's native SMS
TWILIO_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Google Ads (for future MCP integration)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MANAGER_ACCOUNT_ID=
